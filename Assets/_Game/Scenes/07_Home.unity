  m_GameObject: {fileID: 1796401297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c4034bb10c4d984a921266d18b72e82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LWalida.Runtime::LWalida.CutsceneController
  cutsceneId: 07_Home
  lines:
  - speaker: You
    text: Mama? I'm home. I found your house.
    autoAdvanceSeconds: 5
    showMemories: 0
    fadeToBlack: 0
  - speaker: Narrator
    text: Silence. A kettle ticks somewhere behind the wall.
    autoAdvanceSeconds: 5
    showMemories: 0
    fadeToBlack: 0
  - speaker: Narrator
    text: 'Then: a knock.'
    autoAdvanceSeconds: 4
    showMemories: 0
    fadeToBlack: 0
  - speaker: Neighbor
    text: Salam, weldi. I just wanted to offer my condolences. Allah yerhamha. Your
      mother was a wonderful woman.
    autoAdvanceSeconds: 8
    showMemories: 1
    fadeToBlack: 0
  - speaker: You
    text: Thank you. She loved this street.
    autoAdvanceSeconds: 5
    showMemories: 0
    fadeToBlack: 0
  - speaker: Narrator
    text: Some people leave us. But the places they loved never forget them.
    autoAdvanceSeconds: 7
    showMemories: 1
    fadeToBlack: 1
  targetSceneId: 08_Credits
  completionFlag: home_seen
  blackBackground: 0
  knockOnLineIndex: 2
