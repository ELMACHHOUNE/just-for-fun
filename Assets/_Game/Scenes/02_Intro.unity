MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1367891340}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8c4034bb10c4d984a921266d18b72e82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LWalida.Runtime::LWalida.CutsceneController
  cutsceneId: 02_Intro
  lines:
  - speaker: Doctor
    text: Sometimes, familiar places and sounds can help us reconnect with memories.
      You could try showing her the places she once knew.
    autoAdvanceSeconds: 7
    showMemories: 0
    fadeToBlack: 0
  - speaker: Narrator
    text: A taxi door closes. The river is close now, and so is the smell of mint
      tea.
    autoAdvanceSeconds: 6
    showMemories: 0
    fadeToBlack: 0
  - speaker: You
    text: The only photograph I have left of my mother's childhood home.
    autoAdvanceSeconds: 6
    showMemories: 0
    fadeToBlack: 0
  - speaker: You
    text: If the medina remembers her, maybe she will too.
    autoAdvanceSeconds: 5.5
    showMemories: 0
    fadeToBlack: 0
  targetSceneId: 03_CafeMaure
  completionFlag: intro_seen
  blackBackground: 1
  knockOnLineIndex: -1
